+	result = active_fmc->accessiic_array[pIMX728Ctx->sensorDevId]->writeIIC(pIMX728Ctx->i2cId,
+			slave_addr, addr, 0x2, value, datacount);
+
+	if (result != XST_SUCCESS) {
