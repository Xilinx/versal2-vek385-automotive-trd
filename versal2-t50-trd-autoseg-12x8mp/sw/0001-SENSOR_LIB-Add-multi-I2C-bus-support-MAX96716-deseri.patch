+				xil_printf("Des-arr structure loaded for Core-%x from Shared memory\r\n",
+					get_cpu_id());
+			} else {
+				xil_printf("Des-arr structure Already loaded for Core-%x \r\n",
+						get_cpu_id());
+			}
+	}
+
+	xil_printf("Remapping I2c Address on FMC started...\r\n");
+
+	if (core_des_status == 0) {
+		u8 i, j;
+		bool_t core_found = BOOL_FALSE;
+		xil_printf("Inside %s and Value of array: %d\n",__func__,CORE_DES_MAP_SIZE);
+		
+		for (i = 0; i < CORE_DES_MAP_SIZE; i++) {
+			if (core_des_map[i].core_id == get_cpu_id()) {
+				core_found = BOOL_TRUE;
+				xil_printf("Core %d remapping %d deserializers\r\n", get_cpu_id(), core_des_map[i].num_deserializers);
+				
+				for (j = 0; j < core_des_map[i].num_deserializers; j++) {
+					u8 des_idx = core_des_map[i].des_indices[j];
+					u8 i2c_bus = core_des_map[i].i2cBusIds[j];
+					
+					memset(&i2cConfig, 0, sizeof(HalI2cConfig_t));
+
+					i2cConfig.i2cBusId = i2c_bus;
+					i2cConfig.HalI2cMode = HAL_AXI_I2C_MODE;
+					i2cConfig.hHalI2c = NULL;
+					
+					// Initialize AXI I2C HAL
+					u8 result = HalI2cInit(&i2cConfig);
+					if (result != RET_SUCCESS) {
+					xil_printf("%s: Failed to initialize I2C bus %d (error=%d)\n",__func__, i2cConfig.i2cBusId, result);
+						return RET_FAILURE;
+					}
+					xil_printf("%s: I2C bus %d initialized successfully\n",__func__, i2cConfig.i2cBusId);
+					
+					if (Status != XST_SUCCESS)
+						DCT_ASSERT(0);
+					u32 ndes_bit_mask = (1U << des_idx);
+					
+					/* Check if this deserializer is already remapped (check shared memory!) */
+					if (*DES_REMAPPED_STATUS_REG & ndes_bit_mask) {
+						xil_printf("  Deserializer DS_%d already remapped by another core, skipping\r\n", 
+							des_idx + 1);
+						xil_printf("    [Shared status: 0x%08x, bit mask: 0x%08x]\r\n",
+							*DES_REMAPPED_STATUS_REG, ndes_bit_mask);
+						continue;  /* Skip remapping, use existing configuration */
+					}
+					
+					xil_printf("Remapping deserializer DS_%d (I2C bus %d)\r\n", des_idx + 1, i2cConfig.i2cBusId);
+					nRemapping_I2C_addressess(&ndes_arr[des_idx]);
+					
+					/* Mark this deserializer as remapped in shared memory */
+					*DES_REMAPPED_STATUS_REG |= ndes_bit_mask;
+					xil_printf("    [Updated shared status: 0x%08x]\r\n", *DES_REMAPPED_STATUS_REG);
+				}
+				break;
+			}
+		}
+		
+		if (!core_found) {
+			xil_printf("Warning: No deserializer mapping found for core %d\r\n", core_id);
+		}
+		
+		core_des_status = 1;
+		n_on_board_topology();
+		
+		/* Write des_arr[] to shared memory for other cores to read */
+			nWrFmcDataTo_sharedmem();
+			xil_printf("Des-arr structure written to Shared memory for other cores\r\n");
+
+	}
+
+	xil_printf("Remapping I2c Address on FMC Done...\r\n");
+	
+	xil_printf("FMC Init Done\r\n");
+	xil_printf("********************************************************\r\n");
+
+
+		release_fmcinit_lock();
+		xil_printf("FMC init Lock Released \r\n");
+	return Status;
+}
