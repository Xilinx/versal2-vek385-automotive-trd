+ *****************************************************************************/
+int nXylon_Fmc_Setup(int ndes_arr_id)
+{
+	int Status = XST_SUCCESS;
+
+	u16 expander_addr = 0;
+	u32 register_addr = 0;
+	u16 bytes_read = 1;
+	u8 read_data[2] = {0};
+	u8 wr_data[2];
+	u32 core_id;
+	const TickType_t xDelay = 500;
+	HalI2cConfig_t i2cConfig;
+
+	get_fmcinit_lock();
+
+	if (*FMC_INIT_STATUS_REG == 1)
+		fmcinitDone = 1;
+	else
+		fmcinitDone = 0;
+
+	xil_printf("FMC_INIT_STATUS_REG=%x fmcinitDone=%x cpuid=%x\n\r",
+				*FMC_INIT_STATUS_REG, fmcinitDone, get_cpu_id());
+
+	if (fmcinitDone == 0) {
+		xil_printf("********************************************************\r\n");
+		xil_printf("FMC Init Started...\r\n");
+
+
+		//voltage adjustment
+		u8 potent_addr	= 0x2F;
+		register_addr	= 0x00;
+		wr_data[0]	= 0x04;
+
+	
+		Status = HalWriteI2CReg( IIC_INSTANCE_ZERO , potent_addr, register_addr, 0x1, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		sleep(1);
+
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , potent_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf("potentiometer 2-4: Data Read is:[0]:0x%x\r\n", read_data[0]);
+
+/********************************************************************************************/
+
+		//ignore LDAC
+		u16 ldac_addr	= 0x4c;
+		register_addr	= 0x60;
+		wr_data[0] 	= 0xff;
+		wr_data[1] 	= 0xff;
+
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , ldac_addr, register_addr, 0x1, read_data, 2);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf("ldac before: Data Read is:[0]:0x%x\r\n", read_data[0]);
+		xil_printf("ldac : Data Read is:[1]:0x%x\r\n", read_data[1]);
+
+		Status = HalWriteI2CReg(IIC_INSTANCE_ZERO , ldac_addr, register_addr, 0x1, wr_data, 2);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , ldac_addr, register_addr, 0x1, read_data, 2);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf("ldac : after Data Read is:[0]:0x%x\r\n", read_data[0]);
+		xil_printf("ldac : Data Read is:[1]:0x%x\r\n", read_data[1]);
+
+		//DAC 6Gbps
+        	ldac_addr	= 0x4c;
+		register_addr	= 0x3f;
+		wr_data[0]	= 0xff;
+		wr_data[1]	= 0xff;
+
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , ldac_addr, register_addr, 0x1, read_data, 2);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf("before Data Read is:[0]:0x%x\r\n", read_data[0]);
+		xil_printf("Data Read is:[1]:0x%x\r\n", read_data[1]);
+		
+		Status = HalWriteI2CReg(IIC_INSTANCE_ZERO , ldac_addr, register_addr, 0x1, wr_data, 2);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , ldac_addr, register_addr, 0x1, read_data, 2);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf("after Data Read is:[0]:0x%x\r\n", read_data[0]);
+		xil_printf("Data Read is:[1]:0x%x\r\n", read_data[1]);
+
+
+/********************************************************************************************/
+
+		expander_addr	= (0x44 >> 1);
+
+	        register_addr	= 0x0;		
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x00: before :0x%x\n",read_data[0]);
+
+	        register_addr	= 0x4;	
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x04: before :0x%x\n",read_data[0]);
+		
+		wr_data[0]	= 0x80;
+		Status = HalWriteI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		sleep(1);
+
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x04: after :0x%x\n",read_data[0]);
+	        
+		register_addr	= 0x0;		
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x00: after :0x%x\n",read_data[0]);
+
+
+
+	        register_addr	= 0x0c;
+
+		Status = HalReadI2CReg( IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x0c: before :0x%x\n",read_data[0]);
+
+		wr_data[0]	= 0x00;
+		Status = HalWriteI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		sleep(1);
+		
+		Status = HalReadI2CReg( IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x0c: after :0x%x\n",read_data[0]);
+	
+		register_addr	= 0x04;
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x04: after :0x%x\n",read_data[0]);
+	        
+		register_addr	= 0x0;		
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x00: after :0x%x\n",read_data[0]);
+
+
+	        register_addr	= 0x04;
+		
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x04: before :0x%x\n",read_data[0]);
+		
+		expander_addr	= (0x44 >> 1);
+		register_addr   = 0x04;
+		wr_data[0]	= 0x7f;
+		Status = HalWriteI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		sleep(1);
+
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x04-1: after :0x%x\n",read_data[0]);
+	        register_addr	= 0x0;		
+		Status = HalReadI2CReg(IIC_INSTANCE_ZERO , expander_addr, register_addr, 0x1, read_data, bytes_read);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("expander 0x00: before :0x%x\n",read_data[0]);
+		
+		/*
+		 * Here we change I2c address for DS2,4 & 6
+		 */
+
+		/*
+		 * Here we re-map
