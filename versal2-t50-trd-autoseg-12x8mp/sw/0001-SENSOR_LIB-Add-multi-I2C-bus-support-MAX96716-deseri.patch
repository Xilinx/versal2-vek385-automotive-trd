+/**
+ * Core-to-Deserializer-to-I2C Bus Mapping Table
+ *
+ * This table defines the complete hardware topology:
+ *   - Which CPU core manages which deserializers
+ *   - Which I2C bus each deserializer uses
+ *
+ * Format: {core_id, num_des, {des_indices}, {i2cBusIds}}
+ *
+ * I2C Bus Mapping:
+ *   - Bus 0: PS I2C (Processing System)
+ *   - Bus 1: AXI I2C Controller 1
+ *   - Bus 2: AXI I2C Controller 2
+ *   - Bus 3: AXI I2C Controller 3
+ *
+ * Adjust the i2cBusIds array based on your hardware configuration.
+ */
+static const core_des_mapping_t core_des_map[] = {
+	/* Core 6: Manages 3 deserializers (DS_ONE, DS_TWO, DS_THREE) all on I2C bus 1 */
+	{6, 2, {DS_ONE, DS_TWO, 0}, {1, 1, 0}}, /* 4+1*/
+	
+	/* Core 7: Manages 1 deserializer (DS_FOUR) on I2C bus 2 */
+	{7, 2, {DS_THREE, DS_FOUR, 0},{2, 2, 0}}, /* 4+1*/
+	
+	/* Core 8: Manages 2 deserializers (DS_FIVE, DS_SIX) both on I2C bus 3 */
+	//{8, 2, {DS_FIVE, DS_SIX, 0},       {3, 3, 0}},
+	{8, 2, {DS_FIVE, DS_SIX, 0}, {3, 3, 0}}, /* 1+1 */
+};
+
+#define CORE_DES_MAP_SIZE (sizeof(core_des_map) / sizeof(core_des_mapping_t))
+
+/*****************************************************************************/
+/**
+ * GetI2cBusIdForDes - Lookup I2C bus ID for a given deserializer
+ *
+ * @param   desId   Deserializer index (DS_ONE, DS_TWO, DS_THREE, etc.)
+ *
+ * @return  I2C bus ID (0-3) on success, 0xFF on error
+ *
+ * @note    This function searches the core_des_map table to find which
+ *          I2C bus the specified deserializer is connected to.
+ *          
+ *          This centralizes I2C bus topology configuration and provides
+ *          a single point of access for I2C bus mapping.
+ *
+ * Example:
+ *   u8 busId = GetI2cBusIdForDes(DS_ONE);  // Returns 1 (from core_des_map)
+ *
+ ****************************************************************************/
+u8 GetI2cBusIdForDes(u8 desId)
+{
+	u8 i, j;
+	
+	/* Search through all core mappings */
+	for (i = 0; i < CORE_DES_MAP_SIZE; i++) {
+		/* Check each deserializer assigned to this core */
+		for (j = 0; j < core_des_map[i].num_deserializers; j++) {
+			if (core_des_map[i].des_indices[j] == desId) {
+				u8 busId = core_des_map[i].i2cBusIds[j];
+				xil_printf("%s: desId=%d -> i2cBusId=%d (core=%d)\n",
+				           __func__,desId, busId, core_des_map[i].core_id);
+				return busId;
+			}
+		}
+	}
+	
+	/* Deserializer not found in mapping table */
+	xil_printf("ERROR: GetI2cBusIdForDes() - desId %d not found in core_des_map!\n", desId);
+	xil_printf("       Check core_des_map[] configuration in max9296.c\n");
+	return 0xFF;  /* Invalid bus ID */
+}
