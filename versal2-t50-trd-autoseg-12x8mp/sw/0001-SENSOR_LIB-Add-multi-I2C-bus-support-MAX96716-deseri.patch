+/*******************************************************************************
+ *          nRemapping_I2C_addressess
+ *
+ * @brief   Remap default I2C device addresses to new virtual addresses
+ *          for deserializer, serializer and sensor as defined in isi.h
+ *
+ * @param   desIface      Pointer to deserializer interface structure
+ *
+ * @return  None
+ *
+ *****************************************************************************/
+void nRemapping_I2C_addressess(desInterface *desIface) {
+	int Status = XST_SUCCESS;
+	u16 expander_addr = 0;
+	u32 register_addr = 0;
+	u16 bytes_read = 1;
+	u8 read_data[2] = {0};
+	const TickType_t xDelay = 500; // portTICK_PERIOD_MS;
+
+	u8 wr_data[2];
+	u8 i2cBusId = GetI2cBusIdForDes(desIface->Port_DES_index);
+	u8 Deser_addr;
+	u16 reg_addr;
+	u8 ser_addr;
+	const TickType_t xDelay2 = 100;
+	u8 idx;
+	dslink *link_ptr;
+
+	Deser_addr = (desIface->des_actual_addr >> 1);//des_addr>>1;
+	xil_printf("Inside %s and Default Des Addr: 0x%x and Alias: 0x%x\n",__func__,desIface->des_actual_addr,Deser_addr);
+	xil_printf("I2C bus ID passed: %d\n",i2cBusId);
+	
+	nXylon_Deser_Enable(desIface->Port_DES_index);
+	xil_printf("middha - %s - des:%d\n", __func__, desIface->Port_DES_index);
+
+	{
+		Deser_addr = (desIface->des_actual_addr >> 1);
+		reg_addr = DEV_ADDR_REG;
+
+		Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			xil_printf("middha - read failed\n");
+		}
+		xil_printf("des_base before =%x\n", read_data[0]);
+
+		wr_data[0] = desIface->des_alias_addr;
+		Status = HalWriteI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			xil_printf("middha - write failed\n");
+		}
+
+		//Load Deser_addr
+		Deser_addr = (desIface->des_alias_addr) >> 1;
+		Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			xil_printf("middha - read failed\n");
+		}
+		xil_printf("des_base after =%x\n", read_data[0]);
+	}
+
+/******************************************************************************************/
+
+	nprobe_if_links(Deser_addr, desIface);
+
+
+	if (desIface->link_type == NO_LINK) {
+#if defined (READ_I2C_REG)
+		xil_printf("No Sensor Available on link a/B on Deserializer-[0x%x] \n\r so not re-mapping Address of Serializer and Sensor\r\n", desIface->des_alias_addr);
+#endif
+
+		return;
+	}
+
+	xil_printf("Re-mapping Serializer & Sensor Addresses at Deserializer-[0x%x]\r\n", desIface->des_alias_addr);
+
+	if (desIface->link_type == LINK_REVERSE_SPLITTER) {
+
+		xil_printf("Configure De-serializer in reverse splitter mode \r\n");
+
+		xil_printf("Configure Link-A in reverse splitter mode \r\n");
+
+		link_ptr =& (desIface->link_a);
+		Deser_addr = (desIface->des_alias_addr)>>1;
+		reg_addr = 0x10;
+
+		Status = HalReadI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("Rev Split before CTRL0: 0x%x\n",read_data[0]);
+		/*Disable Auto-Link*/
+	Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	read_data[0] = read_data[0] & (~(1 << AUTO_LINK));
+	wr_data[0] = read_data[0];
+
+	Status = HalWriteI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			wr_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+#if defined(READ_I2C_REG)
+	xil_printf("Rev Split CTRL0 =%x\n\r", read_data[0]);
+#endif
+
+//New Reg Address added for LinkA_EN
+	reg_addr = GMSL1_EN;
+	Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	read_data[0] = read_data[0] & (~(LINK_MASK));
+	read_data[0] = read_data[0] | (LINK_A);
+
+	wr_data[0] = read_data[0];
+
+	Status = HalWriteI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			wr_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+xil_printf("A: GMSL1_EN =%x\n\r", read_data[0]);
+
+		/*
+		 * Poll the Link or add delay
+		 */
+		while(1) {
+			xil_printf("Poll for Lock...on link-A \r");
+			vTaskDelay(xDelay2);
+			reg_addr = CTRL3_REG;
+
+			Status = HalReadI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, read_data, 1);
+			if (Status != XST_SUCCESS) {
+				DCT_ASSERT(0);
+			}
+
+			xil_printf("CTRL3_REG =%x \r\n", read_data[0]);
+			if ((read_data[0] & (1<<LOCKED)) == (1<<LOCKED))
+				break;
+		}
+
+		ser_addr = (link_ptr->serializer_default_addr)>>1; //SERIALIZER_DEFAULT_ADDR)>>1;
+		reg_addr = 0x00;
+		wr_data[0] = link_ptr->serializer_alias_addr;// //SERIALIZER_3_ALIAS_ADDR;
+
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf("Serializer on link-A of Deserializer-[0x%x] is configured to Virtual Address-[0x%x]\r\n", desIface->des_alias_addr, link_ptr->serializer_alias_addr);
+
+		/*
+		 * Modifying sensor Address
+		 */
+		ser_addr = (link_ptr->serializer_alias_addr)>>1 ;
+		reg_addr = 0x00;
+
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+//#if defined (READ_I2C_REG)
+		xil_printf(" Just re verifying  serializer new addr :%x\r\n", read_data[0]);
+//#endif
+		reg_addr = 0x7B;
+		wr_data[0] = 0x11;
+
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		reg_addr = 0x83;
+		wr_data[0] = 0x11; //sensor_alias_addr;//SENSOR_3_ALIAS_ADDR;
+
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		reg_addr = 0x8b;
+		wr_data[0] = 0x11; //sensor_alias_addr;//SENSOR_3_ALIAS_ADDR;
+
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		/*
+		 * Configuring sensor Virtual Address
+		 */
+		reg_addr = I2C_2;
+		wr_data[0] = link_ptr->sensor_alias_addr; //sensor_alias_addr;//SENSOR_3_ALIAS_ADDR;
+
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		reg_addr = I2C_3;
+		wr_data[0] = link_ptr->sensor_default_addr;// sensor_default_addr;//SENSOR_DEFAULT_ADDRSS;
+
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+//#if defined (READ_I2C_REG)
+		reg_addr = I2C_2;
+
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf(" I2c_2 :%x\r\n", read_data[0]);
+
+		reg_addr = I2c_3;
+
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf(" I2c_3 :%x\r\n", read_data[0]);
+//#endif
+		xil_printf("Sensor on Serializer-[0x%x] is configured to sensor Virtual Address-[0x%x]\r\n", link_ptr->serializer_alias_addr, link_ptr->sensor_alias_addr);
+
+		/*
+		 * Now configure , Link-B
+		 *
+		 */
+//#if defined (READ_I2C_REG)
+		xil_printf("Configure Link-B in reverse splitter mode \r\n");
+//#endif
+		link_ptr =& (desIface->link_b);
+		Deser_addr = (desIface->des_alias_addr)>>1;
+		reg_addr = 0x10;
+
+		Status = HalReadI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("Link B CTRL0 before : 0x%x\n",read_data[0]);
+
+	Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+	read_data[0] = read_data[0] & (~(1 << AUTO_LINK));
+	read_data[0] = read_data[0] & (~(LINK_MASK));
+	read_data[0] = read_data[0] | (SPLITTER);
+
+	wr_data[0] = read_data[0];
+
+	Status = HalWriteI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			wr_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+#if defined(READ_I2C_REG)
+	xil_printf("Rev Split B: CTRL0 =%x\n\r", read_data[0]);
+#endif
+
+//New Reg Address added for LinkB_EN
+	reg_addr = GMSL1_EN;
+	Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	read_data[0] = read_data[0] & (~(LINK_MASK));
+	read_data[0] = read_data[0] | (SPLITTER);
+
+	wr_data[0] = read_data[0];
+
+	Status = HalWriteI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			wr_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+xil_printf("B: GMSL1_EN =%x\n\r", read_data[0]);
+
+//LINK-B RST
+		reg_addr = 0x12;
+		read_data[0] = read_data[0]|(1<<RESET_ONE_SHOT);
+		wr_data[0] = read_data[0];
+
+		Status = HalWriteI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		Status = HalReadI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, read_data, 1);
+		xil_printf("Link B after RST: 0x%x\n",read_data[0]);
+		/*
+		 * Poll the Link or add delay
+		 */
+		while (1) {
+			xil_printf("Poll for Lock...on link-B \r");
+			vTaskDelay(xDelay2);
+			reg_addr = CTRL9_REG;
+
+			Status = HalReadI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, read_data, 1);
+			if (Status != XST_SUCCESS) {
+				DCT_ASSERT(0);
+			}
+
+			xil_printf("CTRL9_REG =%x \r\n", read_data[0]);
+
+			if ((read_data[0]&(1<<LOCKED)) == (1<<LOCKED))
+				break;
+		}
+
+		ser_addr = (link_ptr->serializer_default_addr)>>1; //SERIALIZER_DEFAULT_ADDR)>>1;
+		reg_addr = 0x00;
+		wr_data[0] = link_ptr->serializer_alias_addr;// //SERIALIZER_3_ALIAS_ADDR;
+
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("Link B Ser Before %x\n",read_data[0]);
+		
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf("Serializer on link-B of Deserializer-[0x%x] is configured to Virtual Address-[0x%x]\r\n", desIface->des_alias_addr, link_ptr->serializer_alias_addr);
+
+		/*
+		 * Modifying sensor Address
+		 */
+		ser_addr = (link_ptr->serializer_alias_addr)>>1 ;
+		reg_addr = 0x00;
+
+		Status = HalReadI2CReg(i2cBusId, ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+//#if defined (READ_I2C_REG)
+		xil_printf(" Just re verifying  serializer new addr:%x\r\n", read_data[0]);
+//#endif
+		reg_addr = I2C_2;
+		wr_data[0] = link_ptr->sensor_alias_addr;
+
+		Status = HalWriteI2CReg(i2cBusId, ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		reg_addr = I2C_3;
+		wr_data[0] = link_ptr->sensor_default_addr;
+
+		Status = HalWriteI2CReg(i2cBusId, ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+//#if defined (READ_I2C_REG)
+		reg_addr = I2C_2;
+
+		Status = HalReadI2CReg(i2cBusId, ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf(" I2c_2 :%x\r\n", read_data[0]);
+
+		reg_addr = I2c_3;
+
+		Status = HalReadI2CReg(i2cBusId, ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf(" I2c_3 :%x\r\n", read_data[0]);
+//#endif
+		xil_printf("Sensor on Serializer-[0x%x] is configured to sensor Virtual Address-[0x%x]\r\n", link_ptr->serializer_alias_addr, link_ptr->sensor_alias_addr);
+	} else {
+		if (desIface->link_type == LINK_A) {
+			link_ptr =& (desIface->link_a);
+		} else {
+			link_ptr =& (desIface->link_b);
+		}
+
+		reg_addr = CTRL0_REG;
+		Status = HalReadI2CReg(i2cBusId, Deser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("before CTRL0 =%x \r\n", read_data[0]);
+
+		/*Disable Auto-Link*/
+		read_data[0] = read_data[0]&(~(1<<AUTO_LINK));
+
+		/*Select Link*/
+		read_data[0] = read_data[0]&(~(LINK_MASK));
+		read_data[0] = read_data[0]|(desIface->link_type);
+		wr_data[0] = read_data[0];
+
+		Status = HalWriteI2CReg(i2cBusId, Deser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		Status = HalReadI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf("after CTRL0 =%x \r\n", read_data[0]);
+		/*
+		 * Do Reset
+		 */
+		if (desIface->link_type == 1)
+			reg_addr = CTRL0_REG;
+		else
+			reg_addr = CTRL1_REG;
+		read_data[0] = read_data[0]|(1<<RESET_ONE_SHOT);
+		wr_data[0] = read_data[0];
+
+		Status = HalWriteI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		reg_addr = GMSL1_EN;
+		Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+				read_data, 1);
+		if (Status != XST_SUCCESS)
+			DCT_ASSERT(0);
+		
+		read_data[0] = read_data[0] & (~(LINK_MASK));
+		read_data[0] = read_data[0] | (desIface->link_type);
+	
+		wr_data[0] = read_data[0];
+	
+		Status = HalWriteI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+				wr_data, 1);
+		if (Status != XST_SUCCESS)
+			DCT_ASSERT(0);
+		
+		Status = HalReadI2CReg(i2cBusId /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+				read_data, 1);
+		if (Status != XST_SUCCESS)
+			DCT_ASSERT(0);
+		xil_printf("GMSL1_EN =%x\n\r", read_data[0]);
+
+		while(1) {
+//#if defined (READ_I2C_REG)
+			xil_printf("Poll for Lock...on link-%c\r\n", (desIface->link_type == LINK_A)?'A':'B');
+//#endif
+
+			vTaskDelay(xDelay2);
+			if(desIface->link_type == 1)
+				reg_addr = CTRL3_REG;
+			else
+				reg_addr = CTRL9_REG;
+
+			Status = HalReadI2CReg(i2cBusId , Deser_addr, reg_addr, 0x2, read_data, 1);
+			if (Status != XST_SUCCESS) {
+				DCT_ASSERT(0);
+			}
+//#if defined (READ_I2C_REG)
+			xil_printf("CTRL%d_REG =%x \r\n", (desIface->link_type == LINK_A)?'3':'9',read_data[0]);
+//#endif
+			if ((read_data[0]&(1<<LOCKED)) == (1<<LOCKED))
+				break;
+		}
+
+		ser_addr = (link_ptr->serializer_default_addr)>>1; //serializer_default_addr>>1;//SERIALIZER_DEFAULT_ADDR>>1;
+		reg_addr = 0x00;
+		wr_data[0] = link_ptr->serializer_alias_addr; //serializer_alias_addr;//SERIALIZER_3_ALIAS_ADDR;
+
+//#if defined (READ_I2C_REG)
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf(" Read Data:%x\r\n", read_data[0]);
+//#endif
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+//#if defined (READ_I2C_REG)
+		xil_printf("Serializer on link-%c of Deserializer-[0x%x] is configured to Virtual Address-[0x%x]\r\n",(desIface->link_type==LINK_A)?'A':'B',desIface->des_alias_addr,link_ptr->serializer_alias_addr);
+//#endif
+		ser_addr = (link_ptr->serializer_alias_addr)>>1 ;//serializer_alias_addr>>1;//SERIALIZER_3_ALIAS_ADDR>>1;
+
+//#if defined (READ_I2C_REG)
+		reg_addr = 0x00;
+
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf(" Read Data:%x\r\n", read_data[0]);
+//#endif
+		reg_addr = I2C_2;
+		wr_data[0] = link_ptr->sensor_alias_addr; //sensor_alias_addr;//SENSOR_3_ALIAS_ADDR;
+
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		reg_addr = I2C_3;
+		wr_data[0] = link_ptr->sensor_default_addr;// sensor_default_addr;//SENSOR_DEFAULT_ADDRSS;
+
+		Status = HalWriteI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+//#if defined (READ_I2C_REG)
+		reg_addr = I2C_2;
+
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf(" I2c_2 :%x\r\n", read_data[0]);
+
+		reg_addr = I2c_3;
+
+		Status = HalReadI2CReg(i2cBusId , ser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		xil_printf(" I2c_3 :%x\r\n", read_data[0]);
+//#endif
+//#if defined (READ_I2C_REG)
+		xil_printf("Sensor on Serializer-[0x%x] is configured to sensor Virtual Address-[0x%x]\r\n", link_ptr->serializer_alias_addr, link_ptr->sensor_alias_addr);
+//#endif
+	}
+//#endif
+	return Status;
+}
