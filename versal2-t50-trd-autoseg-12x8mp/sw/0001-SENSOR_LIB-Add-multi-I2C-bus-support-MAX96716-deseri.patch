+/*******************************************************************************
+ *          nenable_link
+ *
+ * @brief   Enable specified link on the deserializer
+ *
+ * @param   i2c_bus_id    I2C bus ID to use for communication
+ * @param   Deser_addr    Deserializer I2C address
+ * @param   link_type     Type of link to enable
+ *
+ * @return  None
+ *
+ *****************************************************************************/
+void nenable_link(u8 i2c_bus_id, u8 Deser_addr, u8 link_type)
+{
+	int Status = XST_SUCCESS;
+
+	const TickType_t xDelay = 500;
+	u8 read_data[2] = {0};
+	u8 wr_data[2];
+	u16 reg_addr;
+
+	reg_addr = CTRL0_REG;
+	Status = HalReadI2CReg(i2c_bus_id /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	read_data[0] = read_data[0] & (~(1 << AUTO_LINK));
+	// read_data[0] = read_data[0] & (~(LINK_MASK));
+	// read_data[0] = read_data[0] | (link_type);
+
+	wr_data[0] = read_data[0];
+
+	Status = HalWriteI2CReg(i2c_bus_id /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			wr_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	Status = HalReadI2CReg(i2c_bus_id /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+#if defined(READ_I2C_REG)
+	xil_printf("CTRL0 =%x\n\r", read_data[0]);
+#endif
+
+//New Reg Address added for LinkA_EN
+	reg_addr = GMSL1_EN;
+	Status = HalReadI2CReg(i2c_bus_id /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	read_data[0] = read_data[0] & (~(LINK_MASK));
+	read_data[0] = read_data[0] | (link_type);
+
+	wr_data[0] = read_data[0];
+
+	Status = HalWriteI2CReg(i2c_bus_id /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			wr_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+
+	Status = HalReadI2CReg(i2c_bus_id /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+			read_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+xil_printf("GMSL1_EN =%x\n\r", read_data[0]);
+
+
+	/*
+	 * Do Reset
+	 */
+	if (link_type == 1) {
+		xil_printf("middha - reset link-A\n");
+		reg_addr = CTRL0_REG;
+	read_data[0] = read_data[0] | (1 << RESET_ONE_SHOT);
+	wr_data[0] = read_data[0];
+
+	Status = HalWriteI2CReg(i2c_bus_id /*IIC_DEVICE_ID*/, Deser_addr, reg_addr, 0x2,
+				wr_data, 1);
+	if (Status != XST_SUCCESS)
+		DCT_ASSERT(0);
+} else {
+		xil_printf("middha - reset link-B\n");
+		reg_addr = CTRL1_REG;
+		Status = HalReadI2CReg(i2c_bus_id , Deser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+		xil_printf("CTRL1 =%x \n\r",read_data[0]);
+		read_data[0] = read_data[0] | (1 << RESET_ONE_SHOT);
+		wr_data[0] = read_data[0];
+
+		Status = HalWriteI2CReg(i2c_bus_id , Deser_addr, reg_addr, 0x2, wr_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+		}
+
+		Status = HalReadI2CReg(i2c_bus_id , Deser_addr, reg_addr, 0x2, read_data, 1);
+		if (Status != XST_SUCCESS) {
+			DCT_ASSERT(0);
+
+		}
+		xil_printf("CTRL1 =%x \n\r",read_data[0]);
+	}
+}
