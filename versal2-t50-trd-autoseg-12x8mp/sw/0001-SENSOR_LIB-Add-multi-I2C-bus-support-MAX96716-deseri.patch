+static RESULT IMX728_IsiExcuteExpControlIss
+(
+    IsiSensorHandle_t handle,
+    const IsiSensorExpParam_t     *pExpParam,  //from AE
+    IsiSensorExpParam_t          *pExpResult  //return to AE
+)
+{
+    RESULT result = RET_SUCCESS;
+    TRACE(IMX728_INFO, "%s: (enter)\n", __func__);
+    IMX728_Context_t *pIMX728Ctx = (IMX728_Context_t *) handle;
+
+
+    if (pIMX728Ctx == NULL) {
+        return RET_WRONG_HANDLE;
+    }
+    if (pExpParam == NULL || pExpResult == NULL) {
+        return RET_NULL_POINTER;
+    }
+    TRACE(IMX728_INFO, "%s: input integration time: %02f, again: %02f, dgain:%02f, ratio[0]: %f, ispDgain: %f\n", __func__,
+    pExpParam->sensorExpTime[0], pExpParam->sensorAgain[0], pExpParam->sensorDgain[0], pExpParam->sensorRatio[0], pExpParam->ispGain);
+
+    //The gain setting in IMX728 is fixed(1x), ISP gain is equal to real gain
+    pExpResult->sensorAgain[0] = 1.0;
+    pExpResult->sensorDgain[0] = 1.0;
+
+    // multip 10ms x
+    pExpResult->sensorExpTime[0] = (int)(pExpParam->sensorExpTime[0] * 100) / 100.0; //unit s
+    TRACE(IMX728_INFO, "%s: input integration time(s): %02f, output1 integration time(s): %02f.\n", __func__, pExpParam->sensorExpTime[0], pExpResult->sensorExpTime[0]);
+
+    if(pExpResult->sensorExpTime[0] == 0){
+        pExpResult->sensorExpTime[0] = 0.01; //0.01s = 10ms, min unit
+    }
+    pExpResult->ispGain = 1.0f;
+
+    pExpResult->sensorAgain[1] = 1.0;
+    pExpResult->sensorDgain[1] = 1.0;
+    pExpResult->sensorExpTime[1] = pExpResult->sensorExpTime[0];
+
+    pExpResult->sensorAgain[2] = 1.0;
+    pExpResult->sensorDgain[2] = 1.0;
+    pExpResult->sensorExpTime[2] = pExpResult->sensorExpTime[0];
+
+    pExpResult->sensorAgain[3] = 1.0;
+    pExpResult->sensorDgain[3] = 1.0;
+    pExpResult->sensorExpTime[3] = pExpResult->sensorExpTime[0];
+    TRACE(IMX728_INFO, "%s: input integration time(s): %02f, output2 integration time(s): %02f.\n", __func__, pExpParam->sensorExpTime[0], pExpResult->sensorExpTime[0]);
+    TRACE(IMX728_INFO, "%s: realGain: %02f, ISPDigitalGain: %02f\n", __func__, pExpParam->ispGain, pExpResult->ispGain);
+    TRACE(IMX728_INFO, "%s: GxET input(ispGain*expTime(s)): %02f, output(ispGain*expTime(s)): %02f.\n", __func__, pExpParam->ispGain * pExpParam->sensorExpTime[0], pExpResult->ispGain * pExpResult->sensorExpTime[0]);
+
+    TRACE(IMX728_INFO, "%s: (exit)\n", __func__);
+    return result;
+}
