+/*******************************************************************************
+ *          nget_ndes_array
+ *
+ * @brief   Get the deserializer initialization array based on port index
+ *
+ * @param   des           Pointer to deserializer interface structure
+ * @param   ndes_arr       Pointer to pointer for deserializer array
+ *
+ * @return  Return the length of the array.
+ * @retval  len           Number of elements in the initialization array
+ *
+ *****************************************************************************/
+u32 nget_ndes_array(desInterface *des, RegI2CT **ndes_arr)
+{
+	int len;
+
+	if (des->Port_DES_index == PDB_DES_DES1) {
+		*ndes_arr = nDes1_init;
+		len = (sizeof(nDes1_init))/(sizeof(RegI2CT));
+	} else if (des->Port_DES_index == PDB_DES_DES2) {
+		*ndes_arr = nDes2_init;
+		len = (sizeof(nDes2_init))/(sizeof(RegI2CT));
+	} else if (des->Port_DES_index == PDB_DES_DES3) {
+		*ndes_arr = nDes3_init;
+		len = (sizeof(nDes3_init))/(sizeof(RegI2CT));
+	} else if (des->Port_DES_index == PDB_DES_DES4) {
+		*ndes_arr = nDes4_init;
+		len = (sizeof(nDes4_init))/(sizeof(RegI2CT));
+	} else if (des->Port_DES_index == PDB_DES_DES5) {
+		*ndes_arr = nDes5_init;
+		len = (sizeof(nDes5_init))/(sizeof(RegI2CT));
+	} else if (des->Port_DES_index == PDB_DES_DES6) {
+		*ndes_arr = nDes6_init;
+		len = (sizeof(nDes6_init))/(sizeof(RegI2CT));
+	} else if (des->Port_DES_index == PDB_DES_DES7) {
+		*ndes_arr = nDes7_init;
+		len = (sizeof(nDes7_init))/(sizeof(RegI2CT));
+	} else {
+		DCT_ASSERT(0);
+	}
+
+	return len;
+}
