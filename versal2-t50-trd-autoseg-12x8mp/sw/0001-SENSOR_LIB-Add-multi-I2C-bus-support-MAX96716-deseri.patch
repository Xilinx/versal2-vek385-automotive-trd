+/**
+ * @brief Get the appropriate deserializer array based on active FMC
+ * @return Pointer to des_arr for FMC_ID_0, ndes_arr for FMC_ID_1
+ */
+desInterface* get_active_des_array(void) {
+    if (current_active_fmc == FMC_ID_0) {
+        return des_arr;  // Use des_arr for FMC_ID_0
+    } else if (current_active_fmc == FMC_ID_1) {
+        return ndes_arr; // Use ndes_arr for FMC_ID_1
+    } else {
+        xil_printf("Invalid FMC ID: %d, defaulting to des_arr\r\n", current_active_fmc);
+        return des_arr;  // Default fallback
+    }
+}
+
+
+/**
+ * @brief Get FMC instance based on FMC ID
+ * @param fmc_id FMC identifier (FMC_ID_0, FMC_ID_1, etc.)
+ * @return Pointer to FMC instance or NULL if invalid
+ */
+IsiFmc_t* get_fmc_instance(int fmc_id) {
+    switch(fmc_id) {
+        case FMC_ID_0:
+            return &g_fmc_single;  // Existing Xylon FMC
+        case FMC_ID_1:
+            return &g_fmc_second;  // Second FMC instance
+        default:
+            xil_printf("Invalid FMC ID: %d\r\n", fmc_id);
+            return NULL;
+    }
+}
+
+/**
+ * @brief Get currently active FMC instance
+ * @return Pointer to active FMC or NULL if none selected
+ */
+IsiFmc_t* get_active_fmc(void) {
+    if (current_active_fmc == -1) {
+        xil_printf("No FMC selected. Call app_select_fmc() first\r\n");
+        return NULL;
+    }
+    return get_fmc_instance(current_active_fmc);
